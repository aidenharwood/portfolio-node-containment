{
  "name": "containment-online",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build -w @containment/client",
    "start": "npm run start -w @containment/server",
    "test": "node --test --no-warnings=ExperimentalWarning \"packages/*/test/**/*.test.ts\"",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
